"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import BackButton from "@/components/BackButton";
import BottomNavbar from "@/components/BottomNavbar";
import { supabaseBrowser } from "@/lib/supabase-browser";

type MealRow = {
  id: string;
  meal_text: string;
  eaten_at: string;
  meal_type: string | null;
  protein_level: string | null;
  quality_level: string | null;
  ai_notes: string | null;
};

type StravaActivityRow = {
  id: string;
  start_date: string | null;
  distance: number | null;
  moving_time: number | null;
};

type MealType =
  | "café da manhã"
  | "almoço"
  | "lanche"
  | "jantar"
  | "ceia";

function classifyMeal(mealText: string, selectedType: MealType) {
  const text = mealText.toLowerCase();

  let proteinLevel = "baixa";

  if (
    text.includes("frango") ||
    text.includes("chicken") ||
    text.includes("ovo") ||
    text.includes("egg") ||
    text.includes("carne") ||
    text.includes("beef") ||
    text.includes("peixe") ||
    text.includes("fish") ||
    text.includes("atum") ||
    text.includes("salmão") ||
    text.includes("salmao") ||
    text.includes("whey") ||
    text.includes("iogurte") ||
    text.includes("yogurt") ||
    text.includes("peru") ||
    text.includes("turkey")
  ) {
    proteinLevel = "alta";
  } else if (
    text.includes("queijo") ||
    text.includes("cheese") ||
    text.includes("leite") ||
    text.includes("milk") ||
    text.includes("feijão") ||
    text.includes("feijao") ||
    text.includes("beans") ||
    text.includes("lentilha") ||
    text.includes("grão-de-bico") ||
    text.includes("grao-de-bico")
  ) {
    proteinLevel = "média";
  }

  let qualityLevel = "ok";

  if (
    text.includes("pizza") ||
    text.includes("hambúrguer") ||
    text.includes("hamburguer") ||
    text.includes("burger") ||
    text.includes("refrigerante") ||
    text.includes("soda") ||
    text.includes("fritura") ||
    text.includes("frita") ||
    text.includes("batata frita") ||
    text.includes("bolo") ||
    text.includes("cake") ||
    text.includes("cookie") ||
    text.includes("biscoito") ||
    text.includes("doce") ||
    text.includes("chocolate")
  ) {
    qualityLevel = "baixa";
  } else if (
    text.includes("salada") ||
    text.includes("salad") ||
    text.includes("fruta") ||
    text.includes("fruit") ||
    text.includes("arroz") ||
    text.includes("rice") ||
    text.includes("feijão") ||
    text.includes("feijao") ||
    text.includes("beans") ||
    text.includes("legume") ||
    text.includes("vegetable") ||
    text.includes("aveia") ||
    text.includes("oat") ||
    text.includes("batata") ||
    text.includes("mandioca")
  ) {
    qualityLevel = "boa";
  }

  let aiNotes = "Refeição registrada. Continue mantendo consistência.";

  if (qualityLevel === "baixa") {
    aiNotes =
      "Essa refeição parece ter maior presença de ultraprocessados. Nas próximas escolhas, tente incluir comida de verdade, vegetais e uma fonte de proteína.";
  } else if (qualityLevel === "boa" && proteinLevel === "alta") {
    aiNotes =
      "Boa combinação de qualidade alimentar e proteína para apoiar energia, recuperação e manutenção muscular.";
  } else if (proteinLevel === "baixa") {
    aiNotes =
      "Considere adicionar uma fonte de proteína para melhorar saciedade e recuperação muscular.";
  } else if (qualityLevel === "boa") {
    aiNotes =
      "Boa qualidade alimentar. Para deixar a refeição ainda mais completa, mantenha equilíbrio entre proteína, carboidrato e vegetais.";
  }

  return {
    meal_type: selectedType,
    protein_level: proteinLevel,
    quality_level: qualityLevel,
    ai_notes: aiNotes,
  };
}

function startOfLocalDay(date: Date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate());
}

function isToday(dateText: string) {
  const date = new Date(dateText);
  const today = new Date();

  return (
    date.getFullYear() === today.getFullYear() &&
    date.getMonth() === today.getMonth() &&
    date.getDate() === today.getDate()
  );
}

function isWithinDays(dateText: string | null, days: number) {
  if (!dateText) return false;

  const date = new Date(dateText);

  if (Number.isNaN(date.getTime())) return false;

  const today = startOfLocalDay(new Date());
  const activityDay = startOfLocalDay(date);
  const difference =
    (today.getTime() - activityDay.getTime()) / (1000 * 60 * 60 * 24);

  return difference >= 0 && difference < days;
}

function formatMealDate(dateText: string) {
  const date = new Date(dateText);

  if (Number.isNaN(date.getTime())) return "-";

  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function qualityLabel(value: string | null) {
  if (value === "boa") return "Boa";
  if (value === "baixa") return "Pode melhorar";
  return "Equilibrada";
}

function proteinLabel(value: string | null) {
  if (value === "alta") return "Alta";
  if (value === "média") return "Média";
  return "Baixa";
}

function getDailyInsight(meals: MealRow[]) {
  if (meals.length === 0) {
    return "Registre sua primeira refeição do dia para começar o acompanhamento.";
  }

  const goodMeals = meals.filter(
    (meal) => meal.quality_level === "boa"
  ).length;

  const lowQualityMeals = meals.filter(
    (meal) => meal.quality_level === "baixa"
  ).length;

  const highProteinMeals = meals.filter(
    (meal) => meal.protein_level === "alta"
  ).length;

  if (lowQualityMeals >= 2) {
    return "Hoje houve mais refeições com ultraprocessados. Priorize comida de verdade, vegetais e água nas próximas refeições.";
  }

  if (goodMeals >= 2 && highProteinMeals >= 2) {
    return "Seu dia está com boa qualidade alimentar e boa presença de proteína.";
  }

  if (highProteinMeals === 0) {
    return "Ainda não identificamos uma fonte forte de proteína nas refeições de hoje.";
  }

  if (meals.length <= 2) {
    return "Bom começo. Continue registrando as próximas refeições para termos uma visão completa do dia.";
  }

  return "Seu dia está relativamente equilibrado. Continue mantendo consistência.";
}

function getTrainingNutritionInsight(params: {
  meals: MealRow[];
  weeklyActivities: number;
  weeklyDistanceKm: number;
  weeklyHours: number;
}) {
  const {
    meals,
    weeklyActivities,
    weeklyDistanceKm,
    weeklyHours,
  } = params;

  if (weeklyActivities === 0) {
    return "Não encontramos atividades recentes no Strava. Em dias de descanso, mantenha hidratação, proteína e alimentação equilibrada.";
  }

  const highProteinMeals = meals.filter(
    (meal) => meal.protein_level === "alta"
  ).length;

  if (
    (weeklyDistanceKm >= 25 || weeklyHours >= 3) &&
    highProteinMeals <= 1
  ) {
    return "Seu volume de treino recente pede mais atenção à recuperação. Inclua proteína e carboidrato de qualidade nas próximas refeições.";
  }

  if (weeklyActivities >= 4 && meals.length <= 2) {
    return "Você está treinando com frequência, mas ainda registrou poucas refeições. A consistência dos registros ajudará o Coach IA a orientar melhor.";
  }

  return "Sua alimentação parece compatível com a rotina recente. Continue registrando refeições e treinos para melhorar a precisão das orientações.";
}

export default function NutritionPage() {
  const router = useRouter();
  const supabase = useMemo(() => supabaseBrowser, []);

  const [loading, setLoading] = useState(true);
  const [addingMeal, setAddingMeal] = useState(false);
  const [deletingId, setDeletingId] = useState<string | null>(null);

  const [userId, setUserId] = useState<string | null>(null);
  const [profileId, setProfileId] = useState<string | null>(null);

  const [mealText, setMealText] = useState("");
  const [mealType, setMealType] =
    useState<MealType>("café da manhã");

  const [meals, setMeals] = useState<MealRow[]>([]);
  const [activities, setActivities] = useState<StravaActivityRow[]>([]);
  const [message, setMessage] = useState<string | null>(null);

  useEffect(() => {
    const loadPage = async () => {
      const { data: authData, error: authError } =
        await supabase.auth.getUser();

      if (authError || !authData.user) {
        router.replace("/login");
        return;
      }

      const user = authData.user;

      setUserId(user.id);

      const { data: profile } = await supabase
        .from("performance_ai_profiles")
        .select("id")
        .eq("user_id", user.id)
        .maybeSingle();

      setProfileId(profile?.id ?? null);

      const { data: mealData, error: mealError } = await supabase
        .from("performance_ai_meals")
        .select(
          "id, meal_text, eaten_at, meal_type, protein_level, quality_level, ai_notes"
        )
        .eq("user_id", user.id)
        .order("eaten_at", { ascending: false })
        .limit(100);

      if (mealError) {
        setMessage(mealError.message);
      } else {
        setMeals((mealData ?? []) as MealRow[]);
      }

      const { data: tokenRow } = await supabase
        .from("strava_tokens")
        .select("athlete_id")
        .eq("user_id", user.id)
        .order("updated_at", { ascending: false })
        .limit(1)
        .maybeSingle();

      if (tokenRow?.athlete_id) {
        const { data: activityData } = await supabase
          .from("strava_activities")
          .select("id, start_date, distance, moving_time")
          .eq("athlete_id", tokenRow.athlete_id)
          .order("start_date", { ascending: false })
          .limit(100);

        setActivities((activityData ?? []) as StravaActivityRow[]);
      }

      setLoading(false);
    };

    loadPage();
  }, [router, supabase]);

  const handleAddMeal = async () => {
    if (!userId) return;

    const cleanText = mealText.trim();

    if (!cleanText) {
      setMessage("Descreva o que você comeu.");
      return;
    }

    setAddingMeal(true);
    setMessage(null);

    const analysis = classifyMeal(cleanText, mealType);

    const { data, error } = await supabase
      .from("performance_ai_meals")
      .insert({
        user_id: userId,
        profile_id: profileId,
        meal_text: cleanText,
        ...analysis,
      })
      .select(
        "id, meal_text, eaten_at, meal_type, protein_level, quality_level, ai_notes"
      )
      .single();

    if (error) {
      setMessage(error.message);
    } else if (data) {
      setMeals((current) => [data as MealRow, ...current]);
      setMealText("");
      setMessage("Refeição registrada com sucesso.");
    }

    setAddingMeal(false);
  };

  const handleDeleteMeal = async (mealId: string) => {
    setDeletingId(mealId);
    setMessage(null);

    const { error } = await supabase
      .from("performance_ai_meals")
      .delete()
      .eq("id", mealId)
      .eq("user_id", userId);

    if (error) {
      setMessage(error.message);
    } else {
      setMeals((current) =>
        current.filter((meal) => meal.id !== mealId)
      );
      setMessage("Refeição removida.");
    }

    setDeletingId(null);
  };

  const todayMeals = meals.filter((meal) => isToday(meal.eaten_at));

  const goodMealsToday = todayMeals.filter(
    (meal) => meal.quality_level === "boa"
  ).length;

  const proteinMealsToday = todayMeals.filter(
    (meal) => meal.protein_level === "alta"
  ).length;

  const mealsLast7Days = meals.filter((meal) =>
    isWithinDays(meal.eaten_at, 7)
  );

  const weeklyActivitiesData = activities.filter((activity) =>
    isWithinDays(activity.start_date, 7)
  );

  const weeklyActivities = weeklyActivitiesData.length;

  const weeklyDistanceKm = weeklyActivitiesData.reduce(
    (total, activity) =>
      total + Number(activity.distance ?? 0) / 1000,
    0
  );

  const weeklyMovingSeconds = weeklyActivitiesData.reduce(
    (total, activity) =>
      total + Number(activity.moving_time ?? 0),
    0
  );

  const weeklyHours = weeklyMovingSeconds / 3600;

  const recentDays = Array.from({ length: 7 }, (_, index) => {
    const date = new Date();
    date.setDate(date.getDate() - (6 - index));

    const count = meals.filter((meal) => {
      const mealDate = new Date(meal.eaten_at);

      return (
        mealDate.getFullYear() === date.getFullYear() &&
        mealDate.getMonth() === date.getMonth() &&
        mealDate.getDate() === date.getDate()
      );
    }).length;

    return {
      label: date
        .toLocaleDateString("pt-BR", { weekday: "short" })
        .replace(".", ""),
      count,
    };
  });

  const maxDailyMeals = Math.max(
    1,
    ...recentDays.map((item) => item.count)
  );

  if (loading) {
    return (
      <main style={pageStyle}>
        <div style={loadingStyle}>Carregando alimentação...</div>
      </main>
    );
  }

  return (
    <>
      <main style={pageStyle}>
        <div style={contentStyle}>
          <BackButton />

          <section style={heroStyle}>
            <div style={heroIconStyle}>🥗</div>

            <div>
              <p style={eyebrowStyle}>Performance AI</p>

              <h1 style={titleStyle}>Alimentação</h1>

              <p style={subtitleStyle}>
                Registre suas refeições, acompanhe a qualidade
                alimentar e receba orientações relacionadas aos seus
                treinos.
              </p>
            </div>
          </section>

          <section style={summaryGridStyle}>
            <div style={summaryCardStyle}>
              <span style={summaryIconStyle}>🍽️</span>
              <div style={summaryValueStyle}>{todayMeals.length}</div>
              <div style={summaryLabelStyle}>Refeições hoje</div>
            </div>

            <div style={summaryCardStyle}>
              <span style={summaryIconStyle}>🥦</span>
              <div style={summaryValueStyle}>{goodMealsToday}</div>
              <div style={summaryLabelStyle}>Boas escolhas</div>
            </div>

            <div style={summaryCardStyle}>
              <span style={summaryIconStyle}>💪</span>
              <div style={summaryValueStyle}>
                {proteinMealsToday}
              </div>
              <div style={summaryLabelStyle}>
                Refeições com proteína
              </div>
            </div>

            <div style={summaryCardStyle}>
              <span style={summaryIconStyle}>📅</span>
              <div style={summaryValueStyle}>
                {mealsLast7Days.length}
              </div>
              <div style={summaryLabelStyle}>
                Registros em 7 dias
              </div>
            </div>
          </section>

          <section style={mainGridStyle}>
            <div style={panelStyle}>
              <div style={panelHeaderStyle}>
                <div>
                  <p style={panelEyebrowStyle}>Novo registro</p>
                  <h2 style={panelTitleStyle}>
                    Adicionar refeição
                  </h2>
                </div>

                <span style={panelHeaderIconStyle}>＋</span>
              </div>

              <label style={labelStyle}>Tipo da refeição</label>

              <div style={mealTypeGridStyle}>
                {(
                  [
                    "café da manhã",
                    "almoço",
                    "lanche",
                    "jantar",
                    "ceia",
                  ] as MealType[]
                ).map((type) => {
                  const active = mealType === type;

                  return (
                    <button
                      key={type}
                      type="button"
                      onClick={() => setMealType(type)}
                      style={{
                        ...mealTypeButtonStyle,
                        ...(active
                          ? mealTypeButtonActiveStyle
                          : {}),
                      }}
                    >
                      {type}
                    </button>
                  );
                })}
              </div>

              <label style={labelStyle}>
                O que você comeu?
              </label>

              <textarea
                value={mealText}
                onChange={(event) =>
                  setMealText(event.target.value)
                }
                placeholder="Ex.: frango grelhado, arroz, feijão e salada"
                rows={5}
                style={textareaStyle}
              />

              <p style={helperStyle}>
                Descreva os principais alimentos. A análise atual
                classifica automaticamente proteína e qualidade da
                refeição.
              </p>

              <button
                type="button"
                onClick={handleAddMeal}
                disabled={addingMeal}
                style={{
                  ...primaryButtonStyle,
                  opacity: addingMeal ? 0.65 : 1,
                }}
              >
                {addingMeal
                  ? "Registrando..."
                  : "Registrar refeição"}
              </button>
            </div>

            <div style={insightPanelStyle}>
              <div style={panelHeaderStyle}>
                <div>
                  <p style={insightEyebrowStyle}>
                    Análise do dia
                  </p>

                  <h2 style={insightTitleStyle}>
                    Orientação alimentar
                  </h2>
                </div>

                <span style={insightIconStyle}>✨</span>
              </div>

              <p style={insightTextStyle}>
                {getDailyInsight(todayMeals)}
              </p>

              <div style={dividerStyle} />

              <p style={insightEyebrowStyle}>
                Alimentação e treino
              </p>

              <p style={secondaryInsightStyle}>
                {getTrainingNutritionInsight({
                  meals: todayMeals,
                  weeklyActivities,
                  weeklyDistanceKm,
                  weeklyHours,
                })}
              </p>

              <div style={trainingStatsStyle}>
                <div>
                  <span style={trainingStatLabelStyle}>
                    Atividades
                  </span>
                  <strong style={trainingStatValueStyle}>
                    {weeklyActivities}
                  </strong>
                </div>

                <div>
                  <span style={trainingStatLabelStyle}>
                    Distância
                  </span>
                  <strong style={trainingStatValueStyle}>
                    {weeklyDistanceKm.toFixed(1)} km
                  </strong>
                </div>

                <div>
                  <span style={trainingStatLabelStyle}>
                    Tempo
                  </span>
                  <strong style={trainingStatValueStyle}>
                    {weeklyHours.toFixed(1)} h
                  </strong>
                </div>
              </div>
            </div>
          </section>

          <section style={panelStyle}>
            <div style={panelHeaderStyle}>
              <div>
                <p style={panelEyebrowStyle}>Consistência</p>
                <h2 style={panelTitleStyle}>
                  Registros nos últimos 7 dias
                </h2>
              </div>

              <span style={panelHeaderIconStyle}>📊</span>
            </div>

            <div style={chartStyle}>
              {recentDays.map((day) => (
                <div key={day.label} style={chartColumnStyle}>
                  <span style={chartValueStyle}>
                    {day.count}
                  </span>

                  <div style={chartBarTrackStyle}>
                    <div
                      style={{
                        ...chartBarStyle,
                        height: `${Math.max(
                          8,
                          (day.count / maxDailyMeals) * 150
                        )}px`,
                      }}
                    />
                  </div>

                  <span style={chartLabelStyle}>
                    {day.label}
                  </span>
                </div>
              ))}
            </div>
          </section>

          <section style={panelStyle}>
            <div style={panelHeaderStyle}>
              <div>
                <p style={panelEyebrowStyle}>Histórico</p>
                <h2 style={panelTitleStyle}>
                  Refeições registradas
                </h2>
              </div>

              <span style={historyCountStyle}>
                {meals.length}
              </span>
            </div>

            {meals.length === 0 ? (
              <div style={emptyStateStyle}>
                <div style={emptyIconStyle}>🍽️</div>
                <h3 style={emptyTitleStyle}>
                  Nenhuma refeição registrada
                </h3>
                <p style={emptyTextStyle}>
                  Adicione sua primeira refeição para começar o
                  acompanhamento.
                </p>
              </div>
            ) : (
              <div style={historyGridStyle}>
                {meals.map((meal) => (
                  <article key={meal.id} style={mealCardStyle}>
                    <div style={mealTopStyle}>
                      <div>
                        <span style={mealTypeStyle}>
                          {meal.meal_type ?? "refeição"}
                        </span>

                        <p style={mealDateStyle}>
                          {formatMealDate(meal.eaten_at)}
                        </p>
                      </div>

                      <button
                        type="button"
                        onClick={() =>
                          handleDeleteMeal(meal.id)
                        }
                        disabled={deletingId === meal.id}
                        style={deleteButtonStyle}
                      >
                        {deletingId === meal.id
                          ? "Removendo..."
                          : "Excluir"}
                      </button>
                    </div>

                    <h3 style={mealTextStyle}>
                      {meal.meal_text}
                    </h3>

                    <div style={tagRowStyle}>
                      <span
                        style={{
                          ...tagStyle,
                          ...(meal.protein_level === "alta"
                            ? positiveTagStyle
                            : {}),
                        }}
                      >
                        Proteína:{" "}
                        {proteinLabel(meal.protein_level)}
                      </span>

                      <span
                        style={{
                          ...tagStyle,
                          ...(meal.quality_level === "boa"
                            ? positiveTagStyle
                            : meal.quality_level === "baixa"
                            ? warningTagStyle
                            : {}),
                        }}
                      >
                        Qualidade:{" "}
                        {qualityLabel(meal.quality_level)}
                      </span>
                    </div>

                    {meal.ai_notes ? (
                      <div style={mealInsightStyle}>
                        <span>✨</span>
                        <p>{meal.ai_notes}</p>
                      </div>
                    ) : null}
                  </article>
                ))}
              </div>
            )}
          </section>
        </div>

        {message ? (
          <div style={messageStyle}>{message}</div>
        ) : null}
      </main>

      <BottomNavbar />
    </>
  );
}

