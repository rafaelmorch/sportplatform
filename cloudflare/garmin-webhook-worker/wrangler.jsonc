{
  "name": "garmin-webhook-receiver",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "r2_buckets": [
    {
      "binding": "GARMIN_INBOX",
      "bucket_name": "garmin-webhook-inbox"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "garmin-webhook-processing",
        "max_batch_size": 5,
        "max_batch_timeout": 2
      }
    ]
  }
}
